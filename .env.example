# ============================================================================
# AI專利文件生成器 - 環境變量配置文件
# ============================================================================
# 說明：複製此文件為 .env 並填入實際配置值
# 安全提醒：.env 文件包含敏感信息，請勿提交到版本控制系統
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI API 配置
# ----------------------------------------------------------------------------

# OpenAI API 密鑰（可選）
# 說明：如果不設置，用戶必須在生成時輸入自己的 API 密鑰
# 獲取方式：訪問 https://platform.openai.com/api-keys 創建新密鑰
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 注意：請妥善保管密鑰，不要分享給他人或提交到代碼倉庫
# 留空則要求用戶自行提供 API 密鑰
OPENAI_API_KEY=

# 默認使用的 OpenAI 模型
# 可選值：
#   - gpt-4-turbo：最強性能，適合複雜章節（發明內容、具體實施方式）
#   - gpt-4：穩定版本，性能優秀
#   - gpt-3.5-turbo：經濟實惠，適合簡單章節（技術領域、附圖說明）
# 推薦：gpt-4-turbo（系統會自動為簡單章節使用 gpt-3.5-turbo 以節省成本）
OPENAI_MODEL=gpt-4-turbo

# 生成內容的最大 token 數量
# 說明：控制 AI 響應的長度，1 token 約等於 0.75 個中文字
# 範圍：500-4000
# 推薦值：2000（約 1500 中文字）
# 注意：較大值會增加成本，但可能獲得更詳細的內容
OPENAI_MAX_TOKENS=2000

# AI 生成的創造性程度（溫度參數）
# 範圍：0.0-2.0
# 說明：
#   - 0.0-0.3：更確定性，適合技術文檔（但可能過於死板）
#   - 0.4-0.7：平衡創造性和準確性（推薦用於專利文件）
#   - 0.8-1.0：更有創造性（可能偏離專業術語）
# 推薦：0.7
OPENAI_TEMPERATURE=0.7

# API 請求超時時間（秒）
# 說明：單次 API 調用的最長等待時間
# 推薦：60（複雜章節可能需要較長時間）
OPENAI_TIMEOUT=60

# API 請求重試次數
# 說明：當 API 調用失敗時自動重試的次數
# 推薦：3
OPENAI_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# 多 LLM 提供商配置（可選）
# ----------------------------------------------------------------------------
# 說明：以下配置為服務器端默認配置，用戶也可以在生成時輸入自己的 API 密鑰

# 默認使用的 LLM 提供商
# 可選值：openai、claude、gemini、qwen
# 說明：當用戶未指定提供商時使用此默認值
# 推薦：openai（向後兼容）
DEFAULT_LLM_PROVIDER=openai

# Anthropic Claude API 密鑰（可選）
# 獲取方式：訪問 https://console.anthropic.com/settings/keys
# 格式：sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 說明：僅當使用 Claude 作為默認提供商時需要配置
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API 密鑰（可選）
# 獲取方式：訪問 https://aistudio.google.com/app/apikey
# 格式：AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 說明：僅當使用 Gemini 作為默認提供商時需要配置
# GOOGLE_API_KEY=your_google_api_key_here

# 阿里通義千問 API 密鑰（可選）
# 獲取方式：訪問 https://dashscope.console.aliyun.com/apiKey
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 說明：僅當使用通義千問作為默認提供商時需要配置
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ----------------------------------------------------------------------------
# Flask Web 框架配置
# ----------------------------------------------------------------------------

# Flask 應用入口
# 說明：指定 Flask 應用的啟動文件
# 默認：run.py（通常無需修改）
FLASK_APP=run.py

# Flask 運行環境
# 可選值：
#   - development：開發環境（啟用調試、自動重載）
#   - production：生產環境（關閉調試、優化性能）
#   - testing：測試環境
# 警告：生產環境務必使用 production
FLASK_ENV=development

# Flask 密鑰（必填且必須修改）
# 說明：用於加密 session 和 CSRF 保護
# 生成方式：在 Python 中運行 import secrets; print(secrets.token_hex(32))
# 重要：生產環境必須使用強隨機密鑰，不要使用示例值
SECRET_KEY=your_secret_key_here_change_in_production

# Session 存儲類型
# 可選值：
#   - filesystem：存儲在文件系統（適合單機部署）
#   - redis：存儲在 Redis（適合多機部署）
# 推薦：filesystem（除非使用負載均衡）
SESSION_TYPE=filesystem

# 服務器主機地址
# 說明：Flask 監聽的 IP 地址
# 可選值：
#   - 127.0.0.1：僅本機訪問
#   - 0.0.0.0：允許外部訪問
# 推薦：開發環境使用 127.0.0.1，生產環境視需求而定
FLASK_HOST=127.0.0.1

# 服務器端口
# 說明：Flask 監聽的端口號
# 推薦：5000（默認）或其他未被占用的端口
FLASK_PORT=5000

# ----------------------------------------------------------------------------
# 文件存儲配置
# ----------------------------------------------------------------------------

# 生成的專利文件輸出目錄
# 說明：Word 文檔將保存在此目錄
# 注意：目錄會自動創建，確保應用有寫入權限
OUTPUT_DIR=output

# 用戶上傳文件存儲目錄
# 說明：用戶上傳的附圖等文件將保存在此目錄
UPLOAD_DIR=uploads

# 最大上傳文件大小（字節）
# 說明：限制單個上傳文件的大小
# 示例值：
#   - 10485760 = 10 MB
#   - 20971520 = 20 MB
#   - 52428800 = 50 MB
# 推薦：10485760（10 MB）
MAX_UPLOAD_SIZE=10485760

# 允許上傳的文件擴展名
# 說明：逗號分隔的允許上傳的文件類型
# 推薦：僅允許圖片格式
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp

# 文件保留時間（天）
# 說明：自動清理超過指定天數的文件
# 推薦：30（保留 30 天）
# 注意：設為 0 表示永不清理
FILE_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# 應用功能設置
# ----------------------------------------------------------------------------

# 默認語言
# 說明：系統使用的默認語言代碼
# 可選值：zh-CN（簡體中文）、zh-TW（繁體中文）
DEFAULT_LANGUAGE=zh-CN

# 專利生成最大執行時間（秒）
# 說明：生成專利文件的最長允許時間
# 推薦：300（5 分鐘）
# 注意：生成 6 個章節通常需要 2-5 分鐘
MAX_GENERATION_TIME=300

# 啟用內容緩存
# 說明：緩存已生成的章節內容以提高性能
# 可選值：true、false
# 推薦：true（可顯著減少重複生成的成本）
# 注意：開發環境可設為 false 以便測試
ENABLE_CACHING=true

# 緩存過期時間（秒）
# 說明：緩存內容的有效期
# 推薦：3600（1 小時）
CACHE_EXPIRATION=3600

# 並發生成限制
# 說明：同時允許的最大專利生成任務數
# 推薦：3（避免 API 速率限制和服務器過載）
MAX_CONCURRENT_GENERATIONS=3

# 啟用成本追蹤
# 說明：記錄每次生成的 API 成本
# 可選值：true、false
# 推薦：true（便於成本控制和分析）
ENABLE_COST_TRACKING=true

# ----------------------------------------------------------------------------
# 日誌配置
# ----------------------------------------------------------------------------

# 日誌級別
# 可選值（按詳細程度排序）：
#   - DEBUG：最詳細，記錄所有調試信息
#   - INFO：常規信息，記錄重要操作
#   - WARNING：警告信息
#   - ERROR：錯誤信息
#   - CRITICAL：嚴重錯誤
# 推薦：開發環境使用 DEBUG，生產環境使用 INFO
LOG_LEVEL=INFO

# 日誌文件路徑
# 說明：日誌將寫入此文件
# 注意：目錄會自動創建，確保應用有寫入權限
LOG_FILE=logs/app.log

# 日誌輪轉大小（MB）
# 說明：當日誌文件達到此大小時自動創建新文件
# 推薦：10（10 MB）
LOG_ROTATION_SIZE=10

# 日誌保留數量
# 說明：保留的歷史日誌文件數量
# 推薦：5（保留最近 5 個日誌文件）
LOG_RETENTION_COUNT=5

# 啟用控制台日誌輸出
# 說明：是否將日誌同時輸出到控制台
# 可選值：true、false
# 推薦：開發環境使用 true，生產環境使用 false
LOG_TO_CONSOLE=true

# ----------------------------------------------------------------------------
# 開發與調試設置
# ----------------------------------------------------------------------------

# 啟用調試模式
# 說明：Flask 調試模式，提供詳細錯誤頁面和自動重載
# 警告：生產環境必須設為 false（安全風險）
DEBUG=true

# 啟用性能分析
# 說明：記錄 API 請求耗時等性能指標
# 推薦：開發環境使用 true 以優化性能
ENABLE_PROFILING=false

# 模擬 AI 模式（測試用）
# 說明：使用模擬數據代替實際 API 調用，用於測試而不消耗 API 額度
# 可選值：true、false
# 注意：僅用於開發測試，生產環境必須為 false
MOCK_AI_MODE=false

# ----------------------------------------------------------------------------
# 安全配置
# ----------------------------------------------------------------------------

# 啟用 CORS（跨域資源共享）
# 說明：允許前端從不同域名訪問 API
# 可選值：true、false
# 推薦：僅在需要時啟用
ENABLE_CORS=false

# 允許的 CORS 源
# 說明：逗號分隔的允許訪問的域名列表
# 示例：http://localhost:3000,https://example.com
CORS_ORIGINS=http://localhost:3000

# 啟用速率限制
# 說明：限制單個 IP 的請求頻率，防止濫用
# 可選值：true、false
# 推薦：生產環境使用 true
ENABLE_RATE_LIMITING=true

# 速率限制規則
# 說明：每分鐘允許的最大請求數
# 推薦：20（每分鐘 20 次請求）
RATE_LIMIT=20

# ----------------------------------------------------------------------------
# 數據庫配置（可選，未來擴展）
# ----------------------------------------------------------------------------

# 數據庫 URL
# 說明：數據庫連接字符串（目前系統未使用數據庫）
# 格式示例：
#   - SQLite: sqlite:///database.db
#   - PostgreSQL: postgresql://user:password@localhost/dbname
#   - MySQL: mysql://user:password@localhost/dbname
# DATABASE_URL=sqlite:///database.db

# ----------------------------------------------------------------------------
# 其他配置
# ----------------------------------------------------------------------------

# 時區設置
# 說明：應用使用的時區
# 推薦：Asia/Shanghai（中國標準時間）
TIMEZONE=Asia/Shanghai

# 專利文件默認作者
# 說明：如果用戶未指定，使用此默認值
DEFAULT_AUTHOR=未指定

# 專利文件默認申請人
# 說明：如果用戶未指定，使用此默認值
DEFAULT_APPLICANT=未指定
